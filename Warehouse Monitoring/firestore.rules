rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Warehouse monitoring embedded prototype rules
    match /warehouse_products/{skuId} {
      allow read, write: if true;
    }

    match /warehouse_slots/{slotId} {
      allow read, write: if true;
    }

    match /warehouse_alerts/{alertId} {
      allow read, write: if true;
    }

    match /warehouse_events/{eventId} {
      allow read, write: if true;
    }

    match /warehouse_pending/{pendingId} {
      allow read, write: if true;
    }
  }
}
